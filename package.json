{
  "name": "brackenridge-farm",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "build:controller": "node scripts/build-controller.mjs",
    "assets:2d": "node scripts/prepare-2d-prototype-assets.mjs",
    "assets:world2d": "node scripts/prepare-production-world-assets.mjs",
    "map:plan": "node scripts/render-world-plan.mjs",
    "dev": "npm run build:controller && node --import tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:godot": "node --import tsx scripts/test-godot.ts",
    "test:2d": "godot --headless --path game --script res://tests/test_2d_host.gd",
    "test:characters": "godot --headless --path game --script res://tests/test_character_visuals.gd",
    "probe": "godot --path game",
    "export:web": "node scripts/export-web.mjs",
    "export:fireos": "node scripts/export-fireos.mjs",
    "test:map": "godot --headless --path game --script res://tests/test_map_clearance.gd",
    "review:map": "godot --path game --script res://tests/capture_map.gd -- after",
    "assets:cohesive": "node scripts/build-cohesive-terrain.mjs",
    "assets:reference": "node scripts/build-reference-foliage.mjs",
    "assets:buildings": "node scripts/build-reference-buildings.mjs",
    "test:repair": "godot --headless --path game --script res://tests/test_repair_incident.gd",
    "test:solo": "godot --headless --path game --script res://tests/test_solo_playthrough.gd",
    "test:weekend": "godot --headless --path game --script res://tests/test_weekend.gd",
    "test:missions": "godot --headless --path game --script res://tests/test_mission_experience.gd",
    "test:sheep": "godot --headless --path game --script res://tests/test_sheep_motion.gd",
    "test:minimap": "godot --headless --path game --script res://tests/test_minimap.gd",
    "test:fireos-assets": "python3 scripts/verify-fireos-assets.py artifacts/countryside-coop-debug.apk --check-detector",
    "test:coop-route": "godot --headless --path game --script res://tests/test_coop_playthrough.gd",
    "test:finish": "godot --headless --path game --script res://tests/test_finish_pass.gd"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
